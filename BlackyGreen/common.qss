/* ========================= */
/* ========================= */
/* ===== Common styles ===== */
/* ========================= */
/* ========================= */
QWidget {
    background-color: #1f1f1f;
    color: #c0c0c0;
    font-family: "Segoe UI", Arial, sans-serif;
    border: 0px;
}


QWidget:disabled {
    background-color: #0b0b0b;
    color: #909090;
    font-family: "Segoe UI", Arial, sans-serif;
    font-style: italic;
    border: 0px;
}


/* ========================= */
/* ========================= */
/* ======== Labels ========= */
/* ========================= */
/* ========================= */
QLabel {
    background: transparent;
    color: #c0c0c0;
}

QLabel:disabled {
    color: #6a6a6a;
}


/* ========================= */
/* ========================= */
/* ====== Group boxes ====== */
/* ========================= */
/* ========================= */
QGroupBox {
    border: 1px solid #1f4f4d;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 15px;
    background-color: #1a1a1a;
}

QGroupBox[hasBorder="false"] {
    border: none;
    margin-top: 10px;
    padding-top: 15px;
    background-color: #1a1a1a;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px;
    color: #d0d0d0;
}


/* ========================= */
/* ========================= */
/* = Containers / tooltips = */
/* ========================= */
/* ========================= */
QDialog {
    background-color: #1f1f1f;
}

QDialogButtonBox {
    background: transparent;
}

QToolBar {
    background-color: #1f1f1f;
    border: none;
    border-bottom: 1px solid #1f4f4d;
    spacing: 4px;
    padding: 2px;
}

QToolBar::separator {
    background-color: #1f4f4d;
    width: 1px;
    margin: 4px;
}

QStatusBar {
    background-color: #1f1f1f;
    color: #c0c0c0;
    border-top: 1px solid #1f4f4d;
}

QToolTip {
    background-color: #1a1a1a;
    color: #e0e0e0;
    border: 1px solid #1f4f4d;
    border-radius: 4px;
    padding: 4px 6px;
}

QSplitter::handle {
    background-color: #0d0d0d;
}

QSplitter::handle:hover {
    background-color: #1f4f4d;
}


/* ========================= */
/* ========================= */
/* ====== Scroll area ====== */
/* ========================= */
/* ========================= */
QScrollBar {
    border: none;
    background: #0d0d0d;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background-color: #2a2a2a;
    border: 2px solid #1f4f4d;
    min-height: 20px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #2a2a2a;
    border: 2px solid #1f4f4d;
    min-width: 20px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:hover {
    background-color: #2d2d2d;
    border: 2px solid #30605e;
    color: #bbb;
}

QScrollBar::handle:pressed {
    background-color: #383838;
    border: 2px solid #777;
    padding-top: 6px;
    padding-bottom: 4px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: transparent;
    height: 0px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::up-arrow, QScrollBar::down-arrow {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}
