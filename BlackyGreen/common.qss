/* ========================= */
/* ========================= */
/* ===== Common styles ===== */
/* ========================= */
/* ========================= */
QWidget {
    background-color: #1f1f1f;
    color: #c0c0c0;
    font-family: "Segoe UI", Arial, sans-serif;
    border: 0px;
}


QWidget:disabled {
    background-color: #0b0b0b;
    color: #909090;
    font-family: "Segoe UI", Arial, sans-serif;
    font-style: italic;
    border: 0px;
}


/* ========================= */
/* ========================= */
/* ====== Group boxes ====== */
/* ========================= */
/* ========================= */
QGroupBox {
    border: 1px solid #1f4f4d;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 15px;
    background-color: #1a1a1a;
}

QGroupBox[hasBorder="false"] {
    border: none;
    margin-top: 10px;
    padding-top: 15px;
    background-color: #1a1a1a;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px;
    color: #d0d0d0;
}


/* ========================= */
/* ========================= */
/* ====== Push buttons ===== */
/* ========================= */
/* ========================= */
QPushButton {
    background-color: #2a2a2a;
    color: #d0d0d0;
    border: 2px solid #1f4f4d;
    border-radius: 5px;
    padding: 3px 4px;
    min-width: 100px;
}

QPushButton:disabled {
    background-color: #2d2d2d;
    color: #6a6a6a;
    border: 1px solid #3a3a3a;
}

QPushButton:hover {
    background-color: #2d2d2d;
    border: 2px solid #30605e;
    color: #bbb;
}

QPushButton:pressed {
 background-color: #383838;
    border: 2px solid #777;
 padding-top: 6px;
    padding-bottom: 4px;
}


/* ========================= */
/* ========================= */
/* ======== Labels ========= */
/* ========================= */
/* ========================= */
QLabel {
    background: transparent;
    color: #c0c0c0;
}

QLabel:disabled {
    color: #6a6a6a;
}


/* ========================= */
/* ========================= */
/* ===== Input widgets ===== */
/* ========================= */
/* ========================= */
QLineEdit,
QAbstractSpinBox,
QComboBox {
    background-color: #151515;
    color: #d0d0d0;
    border: 1px solid #1f4f4d;
    border-radius: 4px;
    padding: 3px 5px;
    min-height: 16px;
    selection-background-color: #1f4f4d;
    selection-color: #e0e0e0;
}

QLineEdit:hover,
QAbstractSpinBox:hover,
QComboBox:hover {
    border-color: #30605e;
}

QLineEdit:focus,
QAbstractSpinBox:focus,
QComboBox:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border: 1px solid #30605e;
}

QLineEdit:disabled,
QAbstractSpinBox:disabled,
QComboBox:disabled {
    background-color: #0b0b0b;
    color: #6a6a6a;
    border-color: #3a3a3a;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid #1f4f4d;
    background: transparent;
}

QComboBox::drop-down:hover {
    background-color: #2d2d2d;
    border-left-color: #30605e;
}

QComboBox QAbstractItemView {
    background-color: #1a1a1a;
    color: #d0d0d0;
    border: 1px solid #1f4f4d;
    border-radius: 4px;
    outline: 0;
    selection-background-color: #0f1f1d;
    selection-color: #e0e0e0;
}

QComboBox QAbstractItemView::item {
    padding: 3px 6px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #2d2d2d;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #0f1f1d;
    color: #e0e0e0;
}


/* ========================= */
/* ========================= */
/* ====== Text editors ===== */
/* ========================= */
/* ========================= */
QPlainTextEdit,
QTextEdit {
    background-color: #151515;
    color: #c0c0c0;
    border: 1px solid #1f4f4d;
    border-radius: 4px;
    padding: 3px;
    selection-background-color: #1f4f4d;
    selection-color: #e0e0e0;
}

QPlainTextEdit:disabled,
QTextEdit:disabled {
    background-color: #0b0b0b;
    color: #6a6a6a;
    border-color: #3a3a3a;
}


/* ========================= */
/* ========================= */
/* = Check / radio buttons = */
/* ========================= */
/* ========================= */
QCheckBox,
QRadioButton {
    background: transparent;
    color: #c0c0c0;
    spacing: 6px;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: #6a6a6a;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background-color: #151515;
    border: 1px solid #1f4f4d;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 7px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #30605e;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #1f4f4d;
    border-color: #30605e;
}

QRadioButton::indicator:checked {
    background-color: #30605e;
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    background-color: #0b0b0b;
    border-color: #3a3a3a;
}


/* ========================= */
/* ========================= */
/* ==== Sliders / progress = */
/* ========================= */
/* ========================= */
QSlider::groove:horizontal {
    height: 4px;
    background-color: #0d0d0d;
    border: 1px solid #1f4f4d;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #1f4f4d;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #2a2a2a;
    border: 2px solid #1f4f4d;
    width: 12px;
    margin: -6px 0px;
    border-radius: 6px;
}

QSlider::groove:vertical {
    width: 4px;
    background-color: #0d0d0d;
    border: 1px solid #1f4f4d;
    border-radius: 2px;
}

QSlider::sub-page:vertical {
    background-color: #1f4f4d;
    border-radius: 2px;
}

QSlider::handle:vertical {
    background-color: #2a2a2a;
    border: 2px solid #1f4f4d;
    height: 12px;
    margin: 0px -6px;
    border-radius: 6px;
}

QSlider::handle:hover {
    background-color: #2d2d2d;
    border-color: #30605e;
}

QProgressBar {
    background-color: #151515;
    color: #d0d0d0;
    border: 1px solid #1f4f4d;
    border-radius: 4px;
    text-align: center;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #1f4f4d;
    border-radius: 3px;
    margin: 1px;
}

QProgressBar:disabled {
    background-color: #0b0b0b;
    color: #6a6a6a;
    border-color: #3a3a3a;
}


/* ========================= */
/* ========================= */
/* ====== Item views ======= */
/* ========================= */
/* ========================= */
QListView,
QTreeView,
QTableView,
QListWidget,
QTreeWidget,
QTableWidget {
    background-color: #151515;
    alternate-background-color: #191919;
    color: #c0c0c0;
    border: 1px solid #1f4f4d;
    border-radius: 4px;
    outline: 0;
    selection-background-color: #0f1f1d;
    selection-color: #e0e0e0;
}

QListView::item,
QTreeView::item,
QTableView::item {
    padding: 2px;
}

QListView::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
    background-color: #2d2d2d;
}

QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: #0f1f1d;
    color: #e0e0e0;
}

QListView:disabled,
QTreeView:disabled,
QTableView:disabled {
    background-color: #0b0b0b;
    color: #6a6a6a;
    border-color: #3a3a3a;
}

QHeaderView {
    background-color: #1f1f1f;
    border: none;
}

QHeaderView::section {
    background-color: #2a2a2a;
    color: #d0d0d0;
    padding: 3px 5px;
    border: none;
    border-right: 1px solid #1f4f4d;
    border-bottom: 1px solid #1f4f4d;
}

QHeaderView::section:hover {
    background-color: #2d2d2d;
    border-right-color: #30605e;
    border-bottom-color: #30605e;
}

QTableCornerButton::section {
    background-color: #2a2a2a;
    border: none;
    border-right: 1px solid #1f4f4d;
    border-bottom: 1px solid #1f4f4d;
}


/* ========================= */
/* ========================= */
/* == Menus / tool buttons == */
/* ========================= */
/* ========================= */
QMenuBar {
    background-color: #1f1f1f;
    color: #c0c0c0;
    border-bottom: 1px solid #1f4f4d;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #2d2d2d;
    color: #e0e0e0;
    border-radius: 3px;
}

QMenuBar::item:pressed {
    background-color: #0f1f1d;
    border-radius: 3px;
}

QMenu {
    background-color: #1a1a1a;
    color: #c0c0c0;
    border: 1px solid #1f4f4d;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    background: transparent;
    padding: 4px 24px 4px 10px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #0f1f1d;
    color: #e0e0e0;
}

QMenu::item:disabled {
    color: #6a6a6a;
}

QMenu::separator {
    height: 1px;
    background-color: #1f4f4d;
    margin: 4px 6px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
}

QToolButton {
    background-color: #2a2a2a;
    color: #d0d0d0;
    border: 1px solid #1f4f4d;
    border-radius: 4px;
    padding: 3px;
}

QToolButton:hover {
    background-color: #2d2d2d;
    border-color: #30605e;
    color: #bbb;
}

QToolButton:pressed {
    background-color: #383838;
    border-color: #777;
}

QToolButton:checked {
    background-color: #0f1f1d;
    border-color: #30605e;
    color: #e0e0e0;
}

QToolButton:disabled {
    background-color: #2d2d2d;
    color: #6a6a6a;
    border-color: #3a3a3a;
}


/* ========================= */
/* ========================= */
/* = Containers / tooltips = */
/* ========================= */
/* ========================= */
QDialog {
    background-color: #1f1f1f;
}

QDialogButtonBox {
    background: transparent;
}

QToolBar {
    background-color: #1f1f1f;
    border: none;
    border-bottom: 1px solid #1f4f4d;
    spacing: 4px;
    padding: 2px;
}

QToolBar::separator {
    background-color: #1f4f4d;
    width: 1px;
    margin: 4px;
}

QStatusBar {
    background-color: #1f1f1f;
    color: #c0c0c0;
    border-top: 1px solid #1f4f4d;
}

QToolTip {
    background-color: #1a1a1a;
    color: #e0e0e0;
    border: 1px solid #1f4f4d;
    border-radius: 4px;
    padding: 4px 6px;
}

QSplitter::handle {
    background-color: #0d0d0d;
}

QSplitter::handle:hover {
    background-color: #1f4f4d;
}


/* ========================= */
/* ========================= */
/* ====== Scroll area ====== */
/* ========================= */
/* ========================= */
QScrollBar {
    border: none;
    background: #0d0d0d;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
 background-color: #2a2a2a;
    border: 2px solid #1f4f4d;
    min-height: 20px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
 background-color: #2a2a2a;
    border: 2px solid #1f4f4d;
    min-width: 20px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:hover {
    background-color: #2d2d2d;
    border: 2px solid #30605e;
    color: #bbb;
}

QScrollBar::handle:pressed {
    background-color: #383838;
    border: 2px solid #777;
 padding-top: 6px;
    padding-bottom: 4px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: transparent;
    height: 0px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::up-arrow, QScrollBar::down-arrow {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}
