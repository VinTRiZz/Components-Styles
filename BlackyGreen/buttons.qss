/* ========================= */
/* ========================= */
/* ===== Push buttons ====== */
/* ========================= */
/* ========================= */
QPushButton {
    background-color: #2a2a2a;
    color: #d0d0d0;
    border: 2px solid #1f4f4d;
    border-radius: 5px;
    padding: 3px 4px;
    min-width: 100px;
}

QPushButton:disabled {
    background-color: #2d2d2d;
    color: #6a6a6a;
    border: 1px solid #3a3a3a;
}

QPushButton:hover {
    background-color: #2d2d2d;
    border: 2px solid #30605e;
    color: #bbb;
}

QPushButton:pressed {
    background-color: #383838;
    border: 2px solid #777;
    padding-top: 6px;
    padding-bottom: 4px;
}


/* ========================= */
/* ========================= */
/* ===== Tool buttons ===== */
/* ========================= */
/* ========================= */
QToolButton {
    background-color: #2a2a2a;
    color: #d0d0d0;
    border: 1px solid #1f4f4d;
    border-radius: 4px;
    padding: 3px;
}

QToolButton:hover {
    background-color: #2d2d2d;
    border-color: #30605e;
    color: #bbb;
}

QToolButton:pressed {
    background-color: #383838;
    border-color: #777;
}

QToolButton:checked {
    background-color: #0f1f1d;
    border-color: #30605e;
    color: #e0e0e0;
}

QToolButton:disabled {
    background-color: #2d2d2d;
    color: #6a6a6a;
    border-color: #3a3a3a;
}
